# Configuración de Google AI Studio (Gemini 1.5 Pro)
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Configuración del Cliente Firebase (Público)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=qoritupuy-educativo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=qoritupuy-educativo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=qoritupuy-educativo.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Configuración Firebase Admin SDK (Privado / Servidor)
# Puedes colocar el JSON minificado o la ruta a la credencial
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"qoritupuy-educativo",...}'

